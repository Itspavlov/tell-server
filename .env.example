# Скопируйте в .env для локального запуска (файл .env в Git НЕ попадает).
# На Render эти значения задаются в Environment.
PORT=3000
NODE_ENV=development
# Через запятую. Для production укажите адрес вашего сайта.
ALLOWED_ORIGINS=https://gokurort-new.onrender.com
# Секрет администратора, минимум 32 символа. Без него админ-функции выключены.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
# Каталог данных. На Render с Persistent Disk: /var/data
DATA_DIR=./data
# Лимит суммарного размера файла истории (МБ) для приёма новых фото
MAX_STORE_MB=150
